{
  "cli": {
    "version": ">= 3.2.1",
    "promptToConfigurePushNotifications": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "resourceClass": "large",
        "env": {
          "EAS_USE_CACHE": "1"
        }
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "resourceClass": "large",
        "env": {
          "EAS_USE_CACHE": "1"
        },
        "gradleCommand": ":app:assembleRelease --profile",
        "buildArtifactPaths": [
          "android/build/reports/**"
        ]
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CODE_NAME": "kitsune"
      },
      "android": {
        "resourceClass": "large",
        "env": {
          "EAS_RESTORE_CACHE": "0",
          "EAS_SAVE_CACHE": "1"
        }
      }
    },
    "production-simulator": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "simulator": true
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "external-preview": {
      "extends": "production",
      "channel": "external-preview",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1671606312"
      }
    },
    "external-preview": {}
  }
}
